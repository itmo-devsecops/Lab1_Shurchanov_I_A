.env*
*.env
*.pem
*.key
*.crt
Secret.txt

# Local and configuration files
.local/
local/
config.local.*
*.local.yml

# Documentation and markdown
README*
*.md
docs/

# Docker and compose files
Dockerfile*
docker-compose*

# Project-specific patterns
*.tmp

# Ignore gitleaks and pre-commit configs
.gitleaksignore
.gitleaks.toml
.pre-commit-config.yaml

# Ignore XML BOM (if not needed in container)
bom.xml
