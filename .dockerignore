# Version control
.git/
.gitignore
.hg/
.svn/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Build and output directories
build/
dist/
out/
tmp/
temp/

# Test and debug files
test/
tests/
debug/
*.log

